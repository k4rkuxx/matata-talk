# -----------------------------------------------------------------------------
# FVM (Flutter Version Management)
# -----------------------------------------------------------------------------
# Ignorar el symlink local del SDK, pero conservar fvm_config.json / .fvmrc
.fvm/flutter_sdk
.fvm_history

# -----------------------------------------------------------------------------
# IDEs y Editores
# -----------------------------------------------------------------------------
# VS Code: Conservar settings.json para FVM, ignorar el resto
.vscode/*
!.vscode/settings.json

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# -----------------------------------------------------------------------------
# Flutter / Dart / Compilación
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
migrate_working_dir/

# Documentación generada
**/doc/api/
**/ios/Flutter/.last_build_id

# -----------------------------------------------------------------------------
# Android & Keystores (Seguridad)
# -----------------------------------------------------------------------------
/android/app/debug
/android/app/profile
/android/app/release
/android/key.properties
/android/local.properties
*.jks
*.keystore

# -----------------------------------------------------------------------------
# iOS & Certificados
# -----------------------------------------------------------------------------
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
*.p12
*.mobileprovision

# -----------------------------------------------------------------------------
# Sistema Operativo
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.class
*.pyc
*.swp